.program frsky_master_tx
.side_set 1 opt

; --- ORIGINALE MSTRENS SENDS-SCHLEIFE MIT EXAKTEM 8-TICK-TIMING ---
    pull       side 1 [7]  ; Stop-Bit setzen und 8 Takte halten
    set x, 7   side 0 [7]  ; Start-Bit setzen und 8 Takte halten
bitloop:                   
    out pins, 1            ; Datenbit anlegen
    jmp x-- bitloop   [6]  ; Prüfen + 6 Takte warten = EXAKT 8 Zyklen pro Bit!


% c-sdk {
#include "hardware/clocks.h"

// 1. Montagehalle für den Master-Sender
static inline void frsky_master_tx_program_init(PIO pio, uint sm, uint offset, uint pin_tx, uint baud, bool invert) {
    pio_gpio_init(pio, pin_tx);
    if ( invert ) gpio_set_outover(pin_tx,  GPIO_OVERRIDE_INVERT); 
    
    pio_sm_config c = frsky_master_tx_program_get_default_config(offset);
    sm_config_set_out_shift(&c, true, false, 32); // LSB first, no autopull

    sm_config_set_out_pins(&c, pin_tx, 1);
    sm_config_set_sideset_pins(&c, pin_tx);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX); // Tiefer 8-Stufen-Sende-Puffer

    float div = (float)clock_get_hz(clk_sys) / (8 * baud);
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset, &c);
}

// 2. Sender hart ausschalten und Pin auf Eingang setzen (Die Pegel-Befreiung!)
static inline void frsky_master_tx_program_stop(PIO pio, uint sm, uint pin_tx) {
    pio_sm_set_enabled(pio, sm, false); 
    pio_sm_set_pindirs_with_mask(pio, sm, 0 , 1u << pin_tx); 
}

// 3. Sender scharfschalten und Pin als Ausgang deklarieren
static inline void frsky_master_tx_program_start(PIO pio, uint sm, uint pin_tx , bool invert) {
    pio_sm_set_pins_with_mask(pio, sm, 1u << pin_tx, 1u << pin_tx);  
    pio_sm_set_pindirs_with_mask(pio, sm, 1u << pin_tx, 1u << pin_tx); 
    if (invert) gpio_set_outover(pin_tx,  GPIO_OVERRIDE_INVERT); 
    pio_sm_restart (pio, sm); 
    pio_sm_set_enabled(pio, sm, true);
}

// 4. Ein einzelnes Zeichen in den Sende-FIFO schieben
static inline void frsky_master_tx_program_putc(PIO pio, uint sm, char c) {
    pio_sm_put_blocking(pio, sm, (uint32_t)c);
}
%}


.program frsky_master_rx

; --- DER DAZU PASSENDE EMPFÄNGER MIT EXAKTEM MITTEN-ABTAST-TIMING ---
start:
    wait 0 pin 0        ; Warten auf das Startbit
    set x, 7    [10]    ; In die Mitte des ersten Datenbits springen
bitloop_rx:                
    in pins, 1          ; Datenbit einlesen
    jmp x-- bitloop_rx [6] ; 8-mal wiederholen mit exakt 8 Ticks Abstand
    jmp pin good_stop   ; Stop-Bit prüfen

    irq 4 rel           
    wait 1 pin 0        
    jmp start           

good_stop:              
    push                ; Sauberes Byte an C++ übergeben


% c-sdk {
#include "hardware/gpio.h"
#include "hardware/clocks.h"

// 1. Montagehalle für den Master-Empfänger
static inline void frsky_master_rx_program_init(PIO pio, uint sm, uint offset, uint pin_rx, uint baud , bool invert) {
    pio_sm_set_pindirs_with_mask(pio, sm, 0 , 1u << pin_rx); // Initial als Eingang
    pio_gpio_init(pio, pin_rx);
    if (invert) {
        gpio_set_inover(pin_rx,  GPIO_OVERRIDE_INVERT);
        gpio_pull_up(pin_rx); 
    } else {
        gpio_pull_up(pin_rx); 
    }    
    pio_sm_config c = frsky_master_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin_rx); 
    sm_config_set_jmp_pin(&c, pin_rx); 
    sm_config_set_in_shift(&c, true, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX); // Tiefer 8-Stufen-Empfangs-Puffer

    float div = (float)clock_get_hz(clk_sys) / (8 * baud);
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

// 2. Empfänger ausschalten
static inline void frsky_master_rx_program_stop(PIO pio, uint sm, uint pin_rx) {
    pio_sm_set_enabled(pio, sm, false);     
}

// 3. Empfänger zurücksetzen und lauschend scharfschalten
static inline void frsky_master_rx_program_restart(PIO pio, uint sm, uint pin_rx , bool invert) {
    pio_sm_set_pindirs_with_mask(pio, sm, 0 , 1u << pin_rx); 
    if (invert) {
        gpio_set_inover(pin_rx,  GPIO_OVERRIDE_INVERT);
        gpio_pull_up(pin_rx); 
    } else {
        gpio_pull_up(pin_rx); 
    }    
    pio_sm_restart (pio, sm); 
    pio_sm_set_enabled(pio, sm, true);
}    
%}
